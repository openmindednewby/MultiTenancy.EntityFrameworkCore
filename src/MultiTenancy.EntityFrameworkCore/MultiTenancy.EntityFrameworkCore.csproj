<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Override the single TargetFramework inherited from Directory.Build.props: THIS package
         multi-targets so the net8 straggler (AMLService, net8/EF8) can consume it, while the test
         project keeps inheriting the single net10 target. Clearing TargetFramework then setting
         TargetFrameworks is the documented override pattern. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>MultiTenancy</RootNamespace>
    <PackageId>MultiTenancy.EntityFrameworkCore</PackageId>
    <Description>Multi-tenant data isolation for Entity Framework Core. Provides tenant context services, base tenant entity, and query filtering for SaaS applications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DomainCore" Version="1.0.1" />
    <PackageReference Include="Security.Claims" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Provider-agnostic on purpose: the base EF Core package only, never a provider. Questioner
      targets SQLite + SqlServer + Npgsql from one model, so a provider dependency here would leak
      into all three.

      EF version tracks the TFM: net10 consumers are on EF 9.0.6; the net8 target carries an 8.0.x
      floor for the one straggler still on net8/EF8 (AMLService), so it never drags an EF major onto
      a net8 consumer. NuGet resolves to the highest requested version per TFM.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.2.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

</Project>
