<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single-targets net10.0, inherited from Directory.Build.props. This package used to
         multi-target net8.0;net10.0 for "the net8 straggler (AMLService, net8/EF8)" - measured
         2026-08-23, AMLService is net10.0 - and so is every other consumer (AgoraService,
         ContentService, IchnosService, KefiService, NotificationService, OnlineMenuSaaS,
         PaymentService, TenantService, zygos) and the P5 scaffolder's generated backend. Zero
         net8 projects remain. The dead target was not free: DomainCore 1.14.1 and
         Security.Claims 1.5.1 ship lib/net10.0 ONLY (1.0.1 of each ships lib/net8.0 only), so it
         PINNED both at 1.0.1 - thirteen and five minors of lag that read as neglect in the drift
         report. `dotnet restore` with 1.14.1 and this target present fails NU1202; that was
         observed, not assumed. Do not reintroduce the multi-target without a consumer needing it. -->
    <RootNamespace>MultiTenancy</RootNamespace>
    <PackageId>MultiTenancy.EntityFrameworkCore</PackageId>
    <Description>Multi-tenant data isolation for Entity Framework Core. Provides tenant context services, base tenant entity, and query filtering for SaaS applications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DomainCore" Version="1.14.1" />
    <PackageReference Include="Security.Claims" Version="1.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Provider-agnostic on purpose: the base EF Core package only, never a provider. Questioner
      targets SQLite + SqlServer + Npgsql from one model, so a provider dependency here would leak
      into all three.

      The per-TFM conditions went with the net8 target: there is one TFM now, so one EF reference.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.2.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

</Project>
